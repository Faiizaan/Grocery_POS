// ---------- Datasource & Generator ----------
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ---------- Enums ----------
enum Role {
  CASHIER
  MANAGER
  ADMIN
}

enum POStatus {
  DRAFT
  APPROVED
  ORDERED
  RECEIVED
}

// ---------- Core Models ----------
model User {
  id         Int           @id @default(autoincrement())
  email      String        @unique
  password   String
  role       Role          @default(CASHIER)
  createdAt  DateTime      @default(now())
  sales      Sale[]
  voidedSales Sale[]       @relation("VoidedSales")
  sessions   CashSession[]
}

model Category {
  id        Int        @id @default(autoincrement())
  name      String     @unique
  products  Product[]
  saleItems SaleItem[]
}

model Product {
  id          Int       @id @default(autoincrement())
  name        String
  sku         String    @unique
  barcode     String?   @unique
  categoryId  Int?
  categoryRef Category? @relation(fields: [categoryId], references: [id])

  price             Decimal             @db.Decimal(10, 2) // purchase price
  salePrice         Decimal             @db.Decimal(10, 2) // <-- temporarily nullable
  taxRate           Decimal             @db.Decimal(5, 2)
  isWeighted        Boolean             @default(false)
  stock             Decimal             @default(0) @db.Decimal(12, 3)
  createdAt         DateTime            @default(now())
  // relations...
  SaleItem          SaleItem[]
  InventoryTxn      InventoryTxn[]
  PurchaseItem      PurchaseItem[]
  PurchaseOrderItem PurchaseOrderItem[]
  supplierProducts  SupplierProduct[]
}

model Sale {
  id              Int      @id @default(autoincrement())
  createdAt       DateTime @default(now())
  userId          Int
  // NEW
  invoiceCode     String?   @unique // e.g., SL-20251023-0007
  discountPercent Decimal  @default(0) @db.Decimal(5, 2) // 0..100
  discountValue   Decimal  @default(0) @db.Decimal(10, 2) // absolute currency

  subtotal Decimal @db.Decimal(10, 2) // after discount, before tax
  taxTotal Decimal @db.Decimal(10, 2)
  total    Decimal @db.Decimal(10, 2)

  paidCash  Decimal @default(0) @db.Decimal(10, 2)
  paidCard  Decimal @default(0) @db.Decimal(10, 2)
  changeDue Decimal @default(0) @db.Decimal(10, 2)

  items      SaleItem[]
  user       User         @relation(fields: [userId], references: [id])
  sessionId  Int?
  session    CashSession? @relation(fields: [sessionId], references: [id])
  voidedAt   DateTime?
  voidedById Int?
  voidedBy   User?        @relation("VoidedSales", fields: [voidedById], references: [id])

  @@index([createdAt])
  @@index([voidedAt])
}

model SaleItem {
  id         Int       @id @default(autoincrement())
  saleId     Int
  productId  Int
  qty        Decimal   @db.Decimal(12, 3)
  unitPrice  Decimal   @db.Decimal(10, 2)
  taxRate    Decimal   @db.Decimal(5, 2)
  lineTotal      Decimal @db.Decimal(10, 2)
  lineDiscount   Decimal @default(0) @db.Decimal(10, 2)
  unitCostAtSale Decimal @default(0) @db.Decimal(10, 2)
  costTotal      Decimal @default(0) @db.Decimal(10, 2)
  sale       Sale      @relation(fields: [saleId], references: [id])
  product    Product   @relation(fields: [productId], references: [id])
  Category   Category? @relation(fields: [categoryId], references: [id])
  categoryId Int?
}

model InventoryTxn {
  id        Int      @id @default(autoincrement())
  productId Int
  qtyChange Decimal  @db.Decimal(12, 3)
  reason    String
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id])
}

model CashSession {
  id           Int       @id @default(autoincrement())
  userId       Int
  openedAt     DateTime  @default(now())
  closedAt     DateTime?
  openingFloat Decimal   @db.Decimal(10, 2)
  closingCash  Decimal?  @db.Decimal(10, 2)
  sales        Sale[]
  user         User      @relation(fields: [userId], references: [id])
}

// ---------- Purchasing & Suppliers ----------
model Supplier {
  id               Int               @id @default(autoincrement())
  name             String            @unique
  phone            String?
  email            String?
  createdAt        DateTime          @default(now())
  purchases        Purchase[]
  purchaseOrders   PurchaseOrder[]
  supplierProducts SupplierProduct[]
}

model SupplierProduct {
  id              Int      @id @default(autoincrement())
  supplierId      Int
  productId       Int
  unitCost        Decimal  @db.Decimal(10, 2)
  lastPurchasedAt DateTime @default(now())
  updatedAt       DateTime @updatedAt
  supplier        Supplier @relation(fields: [supplierId], references: [id])
  product         Product  @relation(fields: [productId], references: [id])

  @@unique([supplierId, productId])
  @@index([supplierId])
}

model Purchase {
  id         Int            @id @default(autoincrement())
  supplierId Int
  createdAt  DateTime       @default(now())
  items      PurchaseItem[]
  supplier   Supplier       @relation(fields: [supplierId], references: [id])
  discountPercent Decimal @default(0) @db.Decimal(5, 2)
  discountValue   Decimal @default(0) @db.Decimal(10, 2)
  subtotal   Decimal        @db.Decimal(10, 2)
  taxTotal   Decimal        @db.Decimal(10, 2)
  total      Decimal        @db.Decimal(10, 2)
  note       String?
}

model PurchaseItem {
  id           Int      @id @default(autoincrement())
  purchaseId   Int
  productId    Int
  qty          Decimal  @db.Decimal(12, 3)
  unitCost     Decimal  @db.Decimal(10, 2)
  lineDiscount Decimal  @default(0) @db.Decimal(10, 2)
  lineTotal    Decimal  @db.Decimal(10, 2)
  purchase   Purchase @relation(fields: [purchaseId], references: [id])
  product    Product  @relation(fields: [productId], references: [id])
}

model PurchaseOrder {
  id           Int                 @id @default(autoincrement())
  supplierId   Int
  createdAt    DateTime            @default(now())
  daysLookback Int                 @default(7)
  status       POStatus            @default(DRAFT)
  items        PurchaseOrderItem[]
  supplier     Supplier            @relation(fields: [supplierId], references: [id])
  note         String?
}

model PurchaseOrderItem {
  id              Int           @id @default(autoincrement())
  purchaseOrderId Int
  productId       Int
  suggestedQty    Decimal       @db.Decimal(12, 3)
  currentStock    Decimal       @db.Decimal(12, 3)
  recentSales     Decimal       @db.Decimal(12, 3)
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  product         Product       @relation(fields: [productId], references: [id])
}
